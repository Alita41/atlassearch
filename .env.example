# Core service
PORT=8080
ATLAS_INDEX_VERSION=dev-v1

# Optional metadata/cache services
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlassearch
REDIS_URL=redis://localhost:6379/0

# Optional dense retrieval
ATLAS_ENABLE_DENSE=1
ATLAS_DENSE_BACKEND=e5
ATLAS_E5_MODEL=intfloat/multilingual-e5-base
ATLAS_DENSE_INDEX=data/index/e5.faiss
ATLAS_DENSE_IDS=data/index/e5.ids.json
